    "format:write": "nx format:write",
    "help": "nx help",
    "postinstall": "patch-package",
    "kill": "taskkill /IM:node.exe /F",
    "lint": "cross-env NODE_OPTIONS=--max_old_space_size=8192 nx lint",
    "lintall": "cross-env NODE_OPTIONS=--max_old_space_size=8192 nx run-many --target=lint --all --parallel=1 && yarn prettier . --check",
    "lintfix": "cross-env NODE_OPTIONS=--max_old_space_size=8192 nx run-many --target=lint --all --parallel=1 --fix && yarn prettier . --write",
    "nx": "nx",
    "start": "nx serve",
    "start-widget": "cross-env NX_based_url=http://localhost:5000 nx serve widget",
    "startprod": "serve ./dist/apps/dashboard -s",
    "test": "nx test",
    "test-unit": "nx run dashboard:test",
    "testall": "nx run-many --target=test --all",
    "update": "nx migrate latest",
    "workspace-generator": "nx workspace-generator"
