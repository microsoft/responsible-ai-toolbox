    "auto-version": "node ./scripts/auto-version.js",
    "build": "nx build",
    "buildall": "cross-env NODE_OPTIONS=--max_old_space_size=8192 nx run-many --target=build --configuration=production --all --parallel=1",
    "builddebug": "cross-env NODE_OPTIONS=--max_old_space_size=8192 nx run-many --target=build --all --parallel=1",
    "ci": "yarn install --frozen-lock-file && yarn testall --codeCoverage && yarn lintall && yarn buildall && yarn test && yarn e2e",
    "copytest": "node ./scripts/copyTest.js",
    "dep-graph": "nx dep-graph",
    "e2e": "nx e2e dashboard-e2e",
